# 拷贝成 .env 并按需改。.env 被 gitignore 忽略。

# 数据库
DATABASE_URL=postgresql+asyncpg://ruisheng_dev:ruisheng_dev@127.0.0.1:5432/ruisheng

# Redis
REDIS_URL=redis://:dev-redis-pw@127.0.0.1:6379/0

# 共享 schema 期望版本（api/gw 启动时比对）
RUISHENG_SHARED_REQUIRED_VERSION=20260413

# 测试模式开关
USE_EMBEDDED_PG=0

# Stage D 起需要（D3 迁移会读这两个变量，否则 raise RuntimeError）
# dev 环境：保持默认；CI/生产：走 secret manager 注入
RUISHENG_GW_PASSWORD=dev-gw-change-me
RUISHENG_API_PASSWORD=dev-api-change-me

# 告警通知 provider 默认关闭；本地测试不得填真实凭据
API_NOTIFICATION_WECHAT_ENABLED=false
API_NOTIFICATION_EMAIL_ENABLED=false
API_NOTIFICATION_SMS_ENABLED=false
API_NOTIFICATION_VOICE_ENABLED=false
API_NOTIFICATION_WORKER_BATCH=20
API_NOTIFICATION_WORKER_CONCURRENCY=5
API_NOTIFICATION_LEASE_SEC=60
API_NOTIFICATION_PROVIDER_TIMEOUT_SEC=20
API_NOTIFICATION_MAX_ATTEMPTS=5
API_NOTIFICATION_EVENT_MAX_AGE_SEC=604800
GW_ALARM_RELOAD_INTERVAL_SEC=5
GW_RELATION_VALUE_MAX_AGE_SEC=300
