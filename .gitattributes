# 行尾：Windows 仓库但代码用 LF，避免 CRLF 污染 Docker
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
Makefile text eol=lf

# 二进制（不做 diff）
*.pcap binary
*.blob binary
*.parquet binary

# Published point-table bytes (UTF-8 BOM + CRLF) are bound by mapping SHA-256.
docs/point-tables/default-rs485-38-points.csv -text whitespace=cr-at-eol
