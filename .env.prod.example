# ============================================================
# ruisheng-scada 生产环境配置 — 复制为 .env.prod 并填写
# ============================================================
# 注意：.env.prod 已被 .gitignore 忽略，不要提交真实密码
# 密码仅使用 URL-safe 字符 A-Z a-z 0-9 . _ ~ -
# 生成随机密码（Linux/Mac）：openssl rand -hex 24
# 生成随机密码（Windows PowerShell）：
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })

# ---- PostgreSQL 超级用户（migrate 服务使用，用于 alembic 迁移）----
POSTGRES_USER=ruisheng_admin
POSTGRES_PASSWORD=CHANGE_ME_PG_SUPERUSER_PASSWORD

# ---- 应用 DB 角色密码（由 alembic 迁移 D3 写入数据库）----
RUISHENG_GW_PASSWORD=CHANGE_ME_GW_ROLE_PASSWORD
RUISHENG_API_PASSWORD=CHANGE_ME_API_ROLE_PASSWORD

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- JWT 签名密钥（最少 32 字符，随机字符串）----
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS_RANDOM

# ---- 管理端点 Bearer 令牌摘要 ----
# 仅填写批准的高熵令牌 SHA-256（64 位小写十六进制）；原始令牌只交给监控系统保管。
MANAGEMENT_TOKEN_SHA256=CHANGE_ME_MANAGEMENT_TOKEN_SHA256

# ---- 告警通知（默认全部关闭；启用前填写对应凭据）----
API_NOTIFICATION_WECHAT_ENABLED=false
API_NOTIFICATION_EMAIL_ENABLED=false
API_NOTIFICATION_EMAIL_HOST=
API_NOTIFICATION_EMAIL_PORT=587
API_NOTIFICATION_EMAIL_USER=
API_NOTIFICATION_EMAIL_PASSWORD=
API_NOTIFICATION_EMAIL_TLS=true
API_NOTIFICATION_SMS_ENABLED=false
API_NOTIFICATION_SMS_ENDPOINT=
API_NOTIFICATION_SMS_API_KEY=
API_NOTIFICATION_VOICE_ENABLED=false
API_NOTIFICATION_VOICE_ENDPOINT=
API_NOTIFICATION_VOICE_API_KEY=
API_NOTIFICATION_WORKER_BATCH=20
API_NOTIFICATION_WORKER_CONCURRENCY=5
API_NOTIFICATION_LEASE_SEC=60
API_NOTIFICATION_PROVIDER_TIMEOUT_SEC=20
API_NOTIFICATION_MAX_ATTEMPTS=5
API_NOTIFICATION_EVENT_MAX_AGE_SEC=604800
GW_ALARM_RELOAD_INTERVAL_SEC=5
GW_RELATION_VALUE_MAX_AGE_SEC=300

# ---- 网络边界（站点目录覆盖；默认仅回环可达）----
APP_NETWORK_SUBNET=10.254.250.0/24
APP_NETWORK_GATEWAY=10.254.250.1
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=80
WEB_HEALTH_ACL_FILE=./deploy/site-health-acl.conf.example
GW_DEVICE_BIND_HOST=127.0.0.1
GW_DEVICE_BIND_PORT=5020
GW_HEALTH_BIND_HOST=127.0.0.1
GW_HEALTH_BIND_PORT=9090
# 容器内 listener 必须可由 Docker 端口转发命中；宿主暴露仍由具体绑定地址控制
GW_HEALTH_HOST=0.0.0.0
# Docker NAT 后，容器观察到宿主发布端口探针来自固定 bridge 网关。
GW_HEALTH_ALLOWED_CIDRS=10.254.250.1/32

# ---- 候选镜像身份（发布脚本生成候选包时写入精确标签）----
TARGET_PLATFORM=linux/amd64
POSTGRES_IMAGE=ruisheng-candidate/postgres:SET_BY_EXPORT
REDIS_IMAGE=ruisheng-candidate/redis:SET_BY_EXPORT
API_IMAGE=ruisheng-candidate/api:SET_BY_EXPORT
GW_IMAGE=ruisheng-candidate/gw:SET_BY_EXPORT
WEB_IMAGE=ruisheng-candidate/web:SET_BY_EXPORT
